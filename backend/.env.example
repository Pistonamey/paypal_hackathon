# Copy to .env for local development. On Heroku, set these as config vars.
# Never commit real values.

# --- AI (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Channel3 (promo code PAYPAL-HACKATHON-2026 for 20k credits) ---
CHANNEL3_API_KEY=

# --- PayPal sandbox ---
# sandbox = real PayPal sandbox; mock = in-memory fake for local dev/tests only
PAYPAL_MODE=sandbox
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# Shared fallback REST app (used by any seller without its own credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: give each seller agent its own sandbox business account + REST app
SELLER_QUICKPRINT_PAYPAL_CLIENT_ID=
SELLER_QUICKPRINT_PAYPAL_CLIENT_SECRET=
SELLER_BOXCRAFT_PAYPAL_CLIENT_ID=
SELLER_BOXCRAFT_PAYPAL_CLIENT_SECRET=
SELLER_PACKRIGHT_PAYPAL_CLIENT_ID=
SELLER_PACKRIGHT_PAYPAL_CLIENT_SECRET=
# Optional: webhook ID from the developer dashboard to verify webhook signatures
PAYPAL_WEBHOOK_ID=

# --- URLs ---
FRONTEND_URL=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
# Optional: comma-separated A2A seller agent URLs (defaults to the 3 hosted here)
SELLER_AGENT_URLS=

# --- Firebase / Firestore (leave empty to use an in-memory store) ---
# Paste the whole service-account JSON on one line
FIREBASE_CREDENTIALS_JSON=

# --- Security ---
# Long random strings. Changing SIGNING_SEED changes every agent's signing key.
SIGNING_SEED=change-me
CRON_SECRET=change-me
